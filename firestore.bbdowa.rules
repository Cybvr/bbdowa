rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isManager() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager";
    }

    // Admins and managers both run the agency side of the dashboard: giving
    // out tasks, drafting documents, and looking up who's a creator.
    function isStaff() {
      return isAdmin() || isManager();
    }

    function isCreatorProfile() {
      return resource.data.role == "creator"
        || resource.data.get("roles", []).hasAny(["creator"]);
    }

    // A client user of this company (users/{uid} has role "client" and that clientId).
    function isClientOf(clientId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "client"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId == clientId;
    }

    // The client user who owns this company (clients/{clientId}.ownerUid).
    function isCompanyOwner(clientId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clients/$(clientId))
        && get(/databases/$(database)/documents/clients/$(clientId)).data.get("ownerUid", "") == request.auth.uid;
    }

    function validRole() {
      return request.resource.data.role in ["pending", "admin", "manager", "creator", "client"];
    }

    match /users/{userId} {
      // Temporarily public so the dashboard directory and creator pages can
      // render without a sign-in gate. Writes remain protected below.
      allow read: if true;
      allow create: if (isAdmin()
        && validRole())
        || (isManager()
          && request.resource.data.role == "creator"
          && request.resource.data.get("roles", []).hasAny(["creator"]))
        || (isSelf(userId)
          && request.resource.data.uid == userId
          && request.resource.data.role == "pending")
        // A client who signed up and created a company becomes its owner.
        || (isSelf(userId)
          && request.resource.data.uid == userId
          && request.resource.data.role == "client"
          && request.resource.data.roles == ["client"]
          && request.resource.data.clientRole == "owner"
          && exists(/databases/$(database)/documents/clients/$(request.resource.data.clientId))
          && get(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.get("ownerUid", "") == userId)
        // A client invited by email becomes a client of that company on first sign-in.
        || (isSelf(userId)
          && request.resource.data.uid == userId
          && request.resource.data.role == "client"
          && request.resource.data.roles == ["client"]
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/clientInvites/$(request.auth.token.email.lower()))
          && get(/databases/$(database)/documents/clientInvites/$(request.auth.token.email.lower())).data.clientId == request.resource.data.clientId);
      allow update: if (isAdmin()
        && validRole())
        || (isManager()
          && isCreatorProfile()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "title", "department", "location", "email", "phone",
            "profileImage", "category", "dayRate", "availability", "portfolio",
            "rateMin", "rateCurrency",
            "behance", "linkedin", "instagram", "vouchedBy", "craftNote",
            "followerCount", "followerPlatform", "gender", "age", "niche", "updatedAt",
            "entity", "hideRate", "terms", "tags", "referralSource", "workHistory"
          ]))
        || (isSelf(userId)
          && resource.data.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.role == resource.data.role
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["roles", "clientId"]));
      allow delete: if (isAdmin() && userId != request.auth.uid)
        || (isManager() && isCreatorProfile());
    }

    // Dashboard content collections: public to read, admin-only to write.
    // Client users invited by email, keyed by the lower-case email. Read on first sign-in.
    match /clientInvites/{email} {
      allow read: if isStaff()
        || (signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email)
        || isCompanyOwner(resource.data.clientId);
      allow write: if isAdmin();
      // A company owner adds and removes colleagues for their own company.
      allow create: if isCompanyOwner(request.resource.data.clientId)
        && request.resource.data.email == email
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "email", "name", "title", "clientId", "clientName", "invitedBy", "invitedAt"
        ]);
      allow delete: if isCompanyOwner(resource.data.clientId);
    }
    match /clients/{id} {
      allow read: if true;
      allow write: if isStaff();
      // A client signing up creates their own company and owns it.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == id
        && request.resource.data.get("internal", false) == false
        && request.resource.data.keys().hasOnly([
          "type", "slug", "name", "industry", "teamSize", "location", "timezone",
          "website", "description", "date", "internal", "ownerUid", "createdAt", "updatedAt"
        ]);
      // The owner keeps their company profile up to date.
      allow update: if signedIn()
        && resource.data.get("ownerUid", "") == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get("internal", false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "description", "industry", "teamSize", "location", "timezone",
          "website", "profileImage", "updatedAt"
        ]);
    }
    // Client jobs. They lived in `campaigns` before the campaigns → jobs
    // migration; `campaigns` is kept as a backup until it is deleted.
    match /jobs/{id} {
      allow read: if true;
      allow write: if isStaff();
      // Clients post jobs for their own company and edit the brief. The team,
      // lead, status and pay stay with the agency.
      allow create: if isClientOf(request.resource.data.clientId)
        && request.resource.data.postedBy == request.auth.uid
        && request.resource.data.slug == id
        && request.resource.data.status == "active"
        && request.resource.data.leadUserId == null
        && request.resource.data.creatorSlugs == []
        && request.resource.data.publishedBy == null
        && request.resource.data.keys().hasOnly([
          "slug", "name", "title", "campaignTitle", "clientId", "clientName",
          "category", "year", "liveAt", "status", "leadUserId", "creatorSlugs",
          "publishedBy", "fee", "target", "result", "image", "imageAlt", "media",
          "summary", "challenge", "insight", "strategy", "platform", "execution",
          "outcome", "placeholder", "createdAt", "updatedAt", "requiredSkills",
          "workSetup", "estimatedLength", "desiredStartDate", "startDate", "endDate",
          "languages", "postedBy", "postedByName"
        ]);
      allow update: if isClientOf(resource.data.clientId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "title", "campaignTitle", "summary", "category", "requiredSkills",
          "workSetup", "estimatedLength", "desiredStartDate", "startDate", "endDate",
          "languages", "fee", "updatedAt"
        ]);
    }
    match /campaigns/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /blogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Careers openings (stored in `jobs` before the migration).
    match /openings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /resources/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Saved creators and creator lists. Each document belongs to the person
    // it is named after: they read and write only their own.
    match /creatorCollections/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && request.resource.data.uid == userId;
      allow delete: if isSelf(userId);
    }

    // A shared creator list contains only public creator slugs and can be
    // opened by anyone with its URL. Only its owner can publish changes.
    match /sharedCreatorLists/{shareId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // One-off data migrations. `migrations/campaignsToJobs.done` tells the
    // app which collections to read, so everyone can read it.
    match /migrations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Clock in / clock out. Each shift belongs to the person who created it:
    // they read and write only their own; admins and managers can read everyone's.
    match /timeEntries/{id} {
      allow read: if isStaff()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "jobId", "jobName", "campaignSlug", "campaignName"
          ]));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // A job's assignment and pay terms are kept here, keyed by the job slug,
    // because jobs are public. Staff, the assignee and everyone on the
    // job's team (teamUids) can read them; only staff can change them.
    match /jobTerms/{jobId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.assignedTo == request.auth.uid)
        || (signedIn() && request.auth.uid in resource.data.get("teamUids", []));
      allow write: if isStaff();
    }

    // A client's point of contact, kept out of the public client record.
    // Signed-in team members can read it; only staff can change it.
    match /clientContacts/{clientId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // Tasks are public to read for creator profiles. Staff manage all task fields;
    // assignees can edit their tasks, and enabled share links can edit task details.
    match /creatorTasks/{id} {
      allow read: if true;
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isStaff()
        || (request.resource.data.shareEnabled == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["shareEnabled", "updatedAt"]))
        || (resource.data.shareEnabled == true
          && request.resource.data.shareEnabled == true
          && request.resource.data.status in ["todo", "in_progress", "done"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "title", "description", "content", "status", "dueDate",
            "clientId", "clientName", "jobId", "jobName", "updatedAt"
          ]))
        || (signedIn()
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.status in ["todo", "in_progress", "done"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "title", "description", "content", "status", "dueDate",
            "clientId", "clientName", "jobId", "jobName", "updatedAt", "shareEnabled"
          ]));
      allow delete: if isStaff()
        || (signedIn() && resource.data.assignedTo == request.auth.uid);
    }

    // Payments owed to people. Staff record and settle them; each payee
    // can read only their own.
    // What we bill client companies. Staff manage them; a client user sees their
    // own company's invoices once they're sent (never drafts).
    match /invoices/{id} {
      allow read: if isStaff()
        || (signedIn()
          && resource.data.status in ["sent", "paid"]
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "client"
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId == resource.data.clientId);
      allow write: if isStaff();
    }

    match /payments/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.payeeUid == request.auth.uid);
      allow create, update, delete: if isStaff();
    }

    // Private onboarding answers: emergency contact, manager, start date and
    // the equipment checklist. Only the person and staff can read them.
    match /hrRecords/{userId} {
      allow read: if isSelf(userId) || isStaff();
      allow create, update: if (isSelf(userId) && request.resource.data.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Direct messages between two signed-in people. Only the two
    // participants can read the conversation or post into it.
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        // Automatic notes from Bantaba (welcome, onboarding done) are written by the
        // recipient's own app into their own conversation with "bantaba".
        allow create: if signedIn()
          && (request.resource.data.senderId == request.auth.uid
            || (request.resource.data.senderId == "bantaba"
              && request.resource.data.system == true
              && "bantaba" in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants))
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    // A document starts as a draft, can be sent to one creator, and locks when sent.
    match /documents/{id} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.signedAt == null
        && request.resource.data.signedName == null
        && ((request.resource.data.status == "draft" && request.resource.data.assignedTo == null)
          || (request.resource.data.status == "pending_signature"
            && request.resource.data.assignedTo is string
            && request.resource.data.assignedTo.size() > 0));
      allow update: if (isStaff()
          && resource.data.status == "draft"
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.signedAt == null
          && request.resource.data.signedName == null
          && (request.resource.data.status == "draft"
            || (request.resource.data.status == "pending_signature"
              && request.resource.data.assignedTo is string
              && request.resource.data.assignedTo.size() > 0)))
        || (isStaff()
          && resource.data.status == "pending_signature"
          && request.resource.data.status == "pending_signature"
          && request.resource.data.assignedTo is string
          && request.resource.data.assignedTo.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "assignedTo", "assignedToName", "updatedAt"
          ]))
        || (signedIn()
          && resource.data.status == "pending_signature"
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.status == "signed"
          && request.resource.data.signedName is string
          && request.resource.data.signedName.size() > 0
          && request.resource.data.signedAt is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "signedAt", "signedName", "updatedAt"
          ]));
      allow delete: if isAdmin();
    }
  }
}
