rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isManager() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager";
    }

    // Admins and managers both run the agency side of the dashboard: giving
    // out tasks, drafting agreements, and looking up who's a creator.
    function isStaff() {
      return isAdmin() || isManager();
    }

    function isCreatorProfile() {
      return resource.data.role == "creator"
        || resource.data.get("roles", []).hasAny(["creator"]);
    }

    function validRole() {
      return request.resource.data.role in ["pending", "admin", "manager", "creator"];
    }

    match /users/{userId} {
      // Temporarily public so the dashboard directory and creator pages can
      // render without a sign-in gate. Writes remain protected below.
      allow read: if true;
      allow create: if (isAdmin()
        && validRole())
        || (isManager()
          && request.resource.data.role == "creator"
          && request.resource.data.get("roles", []).hasAny(["creator"]))
        || (isSelf(userId)
          && request.resource.data.uid == userId
          && request.resource.data.role == "pending");
      allow update: if (isAdmin()
        && validRole())
        || (isManager()
          && isCreatorProfile()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "title", "department", "location", "email", "phone",
            "profileImage", "category", "dayRate", "availability", "portfolio",
            "rateMin", "rateCurrency",
            "behance", "linkedin", "instagram", "vouchedBy", "craftNote",
            "followerCount", "followerPlatform", "gender", "age", "niche", "updatedAt"
          ]))
        || (isSelf(userId)
          && resource.data.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.role == resource.data.role);
      allow delete: if (isAdmin() && userId != request.auth.uid)
        || (isManager() && isCreatorProfile());
    }

    // Dashboard content collections: public to read, admin-only to write.
    match /clients/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /campaigns/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /blogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /jobs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /resources/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Saved creators and creator lists. Each document belongs to the person
    // it is named after: they read and write only their own.
    match /creatorCollections/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && request.resource.data.uid == userId;
      allow delete: if isSelf(userId);
    }

    // A shared creator list contains only public creator slugs and can be
    // opened by anyone with its URL. Only its owner can publish changes.
    match /sharedCreatorLists/{shareId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Clock in / clock out. Each shift belongs to the person who created it:
    // they read and write only their own; admins and managers can read everyone's.
    match /timeEntries/{id} {
      allow read: if isStaff()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Tasks admins/managers assign to a creator. The creator can move a task
    // through status but can't edit what it says or reassign it.
    match /creatorTasks/{id} {
      allow read: if isStaff()
        || (signedIn() && resource.data.assignedTo == request.auth.uid);
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isStaff()
        || (signedIn()
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.title == resource.data.title
          && request.resource.data.description == resource.data.description
          && request.resource.data.dueDate == resource.data.dueDate);
      allow delete: if isStaff();
    }

    // NDAs and other agreements admins/managers draft for a creator to sign.
    // The creator can only add a signature, never touch the agreement text.
    // A manager can send and view agreements; editing or deleting one is
    // admin-only.
    match /contracts/{id} {
      // Creator agreements are published on public creator profiles. Writes
      // remain restricted below, and only the assigned creator can sign.
      allow read: if true;
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.title == resource.data.title
          && request.resource.data.body == resource.data.body
          && resource.data.status == "pending"
          && request.resource.data.status == "signed");
      allow delete: if isAdmin();
    }

    // Reusable agreement text admins maintain. Managers can read the list to
    // pick one when sending an agreement, but only admins write templates.
    match /contractTemplates/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
