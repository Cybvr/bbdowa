NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=visualhqportfolio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=visualhqportfolio
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=visualhqportfolio.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=920606847094
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=bbdowa

# Njeri (site assistant, app/api/njeri/route.ts). Server-only — no NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
# Optional, defaults to gpt-4o-mini if unset.
OPENAI_MODEL=
# Optional, defaults to gpt-5-mini for research-and-add requests.
OPENAI_RESEARCH_MODEL=

# Comma-separated emails that can run one-off data migrations (Admin → Overview).
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=

# Transactional emails sent by the app (app/api/email). Server-only — no NEXT_PUBLIC_ prefix.
# Set these in Vercel too. The summaries job reads the same names from GitHub secrets.
RESEND_API_KEY=
EMAIL_FROM=
SITE_URL=

# Weekly and monthly summaries job (scripts/send-reminders.mjs, run by GitHub Actions).
# Set these as GitHub repository secrets, not in the website's env.
FIREBASE_PROJECT_ID=visualhqportfolio
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# RESEND_API_KEY, EMAIL_FROM and SITE_URL as above.
